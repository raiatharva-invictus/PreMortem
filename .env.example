# PREMORTEM Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ──────────────────────────────────────────────────────────────
# Backend (runtime/backend/server.ts + trueforge.ts)
# ──────────────────────────────────────────────────────────────

# URL of the running TrueForge instance
# Local dev: http://localhost:8790 (from: npx @truefoundry/trueforge)
# Render production: http://127.0.0.1:8790 (same container, set by render.yaml)
TRUEFORGE_URL=http://localhost:8790

# TrueForge API key (optional if your local TrueForge has no auth configured)
TRUEFORGE_API_KEY=

# Gemini API key (configured inside TrueForge, but set here as a fallback)
GEMINI_API_KEY=

# Daytona workspace URL (required for sandboxed execution)
DAYTONA_WORKSPACE_URL=

# MCP server URL (where TrueForge can reach back to the PREMORTEM MCP server)
# Local dev: http://localhost:3001/mcp
# Render: auto-configured via PORT env var
MCP_SERVER_URL=http://localhost:3001/mcp

# ──────────────────────────────────────────────────────────────
# Frontend (Vite / src/lib/api.ts)
# ──────────────────────────────────────────────────────────────

# URL of the PREMORTEM backend API
# Local dev: http://localhost:3001
# Production: https://premortem-api.onrender.com (or your Render URL)
VITE_BACKEND_URL=http://localhost:3001
